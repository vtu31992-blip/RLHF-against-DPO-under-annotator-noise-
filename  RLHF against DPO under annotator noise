        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# ============================================================\n",
        "# RLHF vs DPO under three levels of annotator noise\n",
        "# Day 5 experiment\n",
        "# ============================================================\n",
        "\n",
        "SEED = 5\n",
        "NOISE_LEVELS = [0.0, 0.20, 0.40]\n",
        "\n",
        "# Experiment settings\n",
        "NUM_PROMPTS = 100\n",
        "NUM_RESPONSES = 6\n",
        "NUM_PAIRS_PER_PROMPT = 30\n",
        "NUM_FEATURES = 4\n",
        "\n",
        "LEARNING_RATE = 0.03\n",
        "EPOCHS = 1000\n",
        "BETA = 1.0\n",
        "KL_COEF = 1.0\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. Generate a synthetic response dataset\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def create_dataset(seed=SEED):\n",
        "    rng = np.random.default_rng(seed)\n",
        "\n",
        "    # Each response has four quality-related features.\n",
        "    features = rng.normal(\n",
        "        size=(NUM_PROMPTS, NUM_RESPONSES, NUM_FEATURES)\n",
        "    )\n",
        "\n",
        "    # The true reward function is unknown to the algorithms.\n",
        "    true_weights = np.array([1.5, 1.0, -0.8, 0.6])\n",
        "\n",
        "    true_rewards = features @ true_weights\n",
        "\n",
        "    # Normalize rewards for easier comparison.\n",
        "    true_rewards = (\n",
        "        true_rewards - true_rewards.mean()\n",
        "    ) / (true_rewards.std() + 1e-8)\n",
        "\n",
        "    return features, true_rewards, true_weights\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. Generate human preference labels with annotator noise\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def generate_preferences(true_rewards, noise, seed):\n",
        "    rng = np.random.default_rng(seed)\n",
        "\n",
        "    prompts, responses = true_rewards.shape\n",
        "\n",
        "    winner_prompt = []\n",
        "    winner_response = []\n",
        "    loser_response = []\n",
        "\n",
        "    for p in range(prompts):\n",
        "        for _ in range(NUM_PAIRS_PER_PROMPT):\n",
        "            i, j = rng.choice(responses, size=2, replace=False)\n",
        "\n",
        "            # The higher-reward response is preferred.\n",
        "            if true_rewards[p, i] >= true_rewards[p, j]:\n",
        "                winner, loser = i, j\n",
        "            else:\n",
        "                winner, loser = j, i\n",
        "\n",
        "            # Annotator noise randomly flips the preference.\n",
        "            if rng.random() < noise:\n",
        "                winner, loser = loser, winner\n",
        "\n",
        "            winner_prompt.append(p)\n",
        "            winner_response.append(winner)\n",
        "            loser_response.append(loser)\n",
        "\n",
        "    return (\n",
        "        np.array(winner_prompt),\n",
        "        np.array(winner_response),\n",
        "        np.array(loser_response),\n",
        "    )\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. Train a reward model for RLHF\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def train_reward_model(features, preferences):\n",
        "    prompt_idx, winner_idx, loser_idx = preferences\n",
        "\n",
        "    num_features = features.shape[-1]\n",
        "    weights = np.zeros(num_features)\n",
        "\n",
        "    # Pairwise logistic regression.\n",
        "    for epoch in range(EPOCHS):\n",
        "        winner_features = features[prompt_idx, winner_idx]\n",
        "        loser_features = features[prompt_idx, loser_idx]\n",
        "\n",
        "        differences = winner_features - loser_features\n",
        "        margins = differences @ weights\n",
        "\n",
        "        # Stable sigmoid.\n",
        "        probabilities = 1.0 / (\n",
        "            1.0 + np.exp(-np.clip(margins, -30, 30))\n",
        "        )\n",
        "\n",
        "        # Gradient of negative log-likelihood.\n",
        "        gradient = (\n",
        "            differences.T @ (probabilities - 1.0)\n",
        "        ) / len(prompt_idx)\n",
        "\n",
        "        # Small L2 regularization.\n",
        "        gradient += 0.01 * weights\n",
        "\n",
        "        weights -= LEARNING_RATE * gradient\n",
        "\n",
        "    return weights\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. RLHF: optimize policy using the learned reward model\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def run_rlhf(features, preferences):\n",
        "    reward_weights = train_reward_model(features, preferences)\n",
        "\n",
        "    predicted_rewards = features @ reward_weights\n",
        "\n",
        "    # KL-regularized reward maximization.\n",
        "    # The reference policy is uniform over responses.\n",
        "    logits = predicted_rewards / KL_COEF\n",
        "    logits -= logits.max(axis=1, keepdims=True)\n",
        "\n",
        "    probabilities = np.exp(logits)\n",
        "    policy = probabilities / probabilities.sum(\n",
        "        axis=1, keepdims=True\n",
        "    )\n",
        "\n",
        "    return policy\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. DPO: directly optimize preference probabilities\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def run_dpo(features, preferences):\n",
        "    prompt_idx, winner_idx, loser_idx = preferences\n",
        "\n",
        "    prompts, responses, num_features = features.shape\n",
        "\n",
        "    # Policy logits initialized to the uniform reference policy.\n",
        "    logits = np.zeros((prompts, responses))\n",
        "\n",
        "    for epoch in range(EPOCHS):\n",
        "        # Log probabilities of the current policy.\n",
        "        shifted = logits - logits.max(axis=1, keepdims=True)\n",
        "        log_probs = shifted - np.log(\n",
        "            np.exp(shifted).sum(axis=1, keepdims=True)\n",
        "        )\n",
        "\n",
        "        margins = BETA * (\n",
        "            log_probs[prompt_idx, winner_idx]\n",
        "            - log_probs[prompt_idx, loser_idx]\n",
        "        )\n",
        "\n",
        "        sigmoid = 1.0 / (\n",
        "            1.0 + np.exp(-np.clip(margins, -30, 30))\n",
        "        )\n",
        "\n",
        "        # Derivative of pairwise DPO loss.\n",
        "        coeff = BETA * (sigmoid - 1.0)\n",
        "\n",
        "        gradient = np.zeros_like(logits)\n",
        "\n",
        "        np.add.at(\n",
        "            gradient,\n",
        "            (prompt_idx, winner_idx),\n",
        "            coeff\n",
        "        )\n",
        "\n",
        "        np.add.at(\n",
        "            gradient,\n",
        "            (prompt_idx, loser_idx),\n",
        "            -coeff\n",
        "        )\n",
        "\n",
        "        gradient /= len(prompt_idx)\n",
        "\n",
        "        # Softmax Jacobian: convert log-probability gradients\n",
        "        # into gradients with respect to policy logits.\n",
        "        policy = np.exp(log_probs)\n",
        "\n",
        "        gradient = gradient - policy * gradient.sum(\n",
        "            axis=1, keepdims=True\n",
        "        )\n",
        "\n",
        "        logits -= LEARNING_RATE * gradient\n",
        "\n",
        "    shifted = logits - logits.max(axis=1, keepdims=True)\n",
        "    probabilities = np.exp(shifted)\n",
        "\n",
        "    return probabilities / probabilities.sum(\n",
        "        axis=1, keepdims=True\n",
        "    )\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. Evaluate each policy using the TRUE reward\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def evaluate_policy(policy, true_rewards):\n",
        "    # Expected reward under the learned policy.\n",
        "    return np.mean(\n",
        "        np.sum(policy * true_rewards, axis=1)\n",
        "    )\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. Run Day 5 experiment at all noise levels\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def main():\n",
        "    features, true_rewards, _ = create_dataset()\n",
        "\n",
        "    results = {\n",
        "        \"RLHF\": [],\n",
        "        \"DPO\": [],\n",
        "    }\n",
        "\n",
        "    print(\"\\nDAY 5: RLHF vs DPO under annotator noise\")\n",
        "    print(\"=\" * 65)\n",
        "\n",
        "    print(\n",
        "        f\"{'Noise':<12}\"\n",
        "        f\"{'RLHF reward':<18}\"\n",
        "        f\"{'DPO reward':<18}\"\n",
        "        f\"{'RLHF - DPO':<15}\"\n",
        "    )\n",
        "\n",
        "    print(\"-\" * 65)\n",
        "\n",
        "    for index, noise in enumerate(NOISE_LEVELS):\n",
        "        preferences = generate_preferences(\n",
        "            true_rewards,\n",
        "            noise,\n",
        "            seed=SEED + index\n",
        "        )\n",
        "\n",
        "        rlhf_policy = run_rlhf(features, preferences)\n",
        "        dpo_policy = run_dpo(features, preferences)\n",
        "\n",
        "        rlhf_score = evaluate_policy(\n",
        "            rlhf_policy, true_rewards\n",
        "        )\n",
        "\n",
        "        dpo_score = evaluate_policy(\n",
        "            dpo_policy, true_rewards\n",
        "        )\n",
        "\n",
        "        gap = rlhf_score - dpo_score\n",
        "\n",
        "        results[\"RLHF\"].append(rlhf_score)\n",
        "        results[\"DPO\"].append(dpo_score)\n",
        "\n",
        "        print(\n",
        "            f\"{noise * 100:>5.0f}%       \"\n",
        "            f\"{rlhf_score:>10.4f}        \"\n",
        "            f\"{dpo_score:>10.4f}        \"\n",
        "            f\"{gap:>10.4f}\"\n",
        "        )\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # 8. Plot comparison\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    x = np.arange(len(NOISE_LEVELS))\n",
        "    width = 0.35\n",
        "\n",
        "    plt.figure(figsize=(9, 5))\n",
        "\n",
        "    plt.bar(\n",
        "        x - width / 2,\n",
        "        results[\"RLHF\"],\n",
        "        width,\n",
        "        label=\"RLHF\"\n",
        "    )\n",
        "\n",
        "    plt.bar(\n",
        "        x + width / 2,\n",
        "        results[\"DPO\"],\n",
        "        width,\n",
        "        label=\"DPO\"\n",
        "    )\n",
        "\n",
        "    plt.xticks(\n",
        "        x,\n",
        "        [f\"{int(n * 100)}% noise\" for n in NOISE_LEVELS]\n",
        "    )\n",
        "\n",
        "    plt.xlabel(\"Annotator noise\")\n",
        "    plt.ylabel(\"Expected true reward\")\n",
        "    plt.title(\"Day 5: RLHF vs DPO under annotator noise\")\n",
        "    plt.axhline(0, linewidth=0.8)\n",
        "    plt.legend()\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # 9. Plot the gap between the methods\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    gaps = np.array(results[\"RLHF\"]) - np.array(results[\"DPO\"])\n",
        "\n",
        "    plt.figure(figsize=(8, 4))\n",
        "\n",
        "    plt.plot(\n",
        "        [n * 100 for n in NOISE_LEVELS],\n",
        "        gaps,\n",
        "        marker=\"o\"\n",
        "    )\n",
        "\n",
        "    plt.axhline(0, linewidth=0.8)\n",
        "    plt.xlabel(\"Annotator noise (%)\")\n",
        "    plt.ylabel(\"RLHF reward - DPO reward\")\n",
        "    plt.title(\"How the RLHF-DPO performance gap changes\")\n",
        "    plt.xticks([0, 20, 40])\n",
        "    plt.grid(True, alpha=0.3)\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # 10. Report how the gap changes\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    print(\"\\nGAP ANALYSIS\")\n",
        "    print(\"-\" * 40)\n",
        "\n",
        "    for i, noise in enumerate(NOISE_LEVELS):\n",
        "        print(\n",
        "            f\"Noise {noise * 100:.0f}%: \"\n",
        "            f\"RLHF-DPO gap = {gaps[i]:.4f}\"\n",
        "        )\n",
        "\n",
        "    change_0_20 = gaps[1] - gaps[0]\n",
        "    change_20_40 = gaps[2] - gaps[1]\n",
        "\n",
        "    print(\n",
        "        \"\\nChange in gap from 0% to 20% noise: \"\n",
        "        f\"{change_0_20:+.4f}\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"Change in gap from 20% to 40% noise: \"\n",
        "        f\"{change_20_40:+.4f}\"\n",
        "    )\n",
        "\n",
        "    if gaps[0] > 0:\n",
        "        print(\n",
        "            \"\\nAt 0% noise, RLHF performs better than DPO.\"\n",
        "        )\n",
        "    elif gaps[0] < 0:\n",
        "        print(\n",
        "            \"\\nAt 0% noise, DPO performs better than RLHF.\"\n",
        "        )\n",
        "    else:\n",
        "        print(\"\\nAt 0% noise, both methods tie.\")\n",
        "\n",
        "    if abs(gaps[-1]) > abs(gaps[0]):\n",
        "        print(\n",
        "            \"The absolute performance gap is larger \"\n",
        "            \"at 40% noise than at 0% noise.\"\n",
        "        )\n",
        "    elif abs(gaps[-1]) < abs(gaps[0]):\n",
        "        print(\n",
        "            \"The absolute performance gap is smaller \"\n",
        "            \"at 40% noise than at 0% noise.\"\n",
        "        )\n",
        "    else:\n",
        "        print(\n",
        "            \"The absolute performance gap is unchanged \"\n",
        "            \"between 0% and 40% noise.\"\n",
        "        )\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()\n"
      ]
